--- /dev/null
+++ b/sql/chat/002_existing_chat_messages_view.sql
@@ -0,0 +1,55 @@
+-- BB CHAT: EXISTING TABLES ONLY
+-- Run this file against the existing Chat Supabase project.
+-- It does not create, alter, delete, or index any source table.
+-- It creates one read View from the two existing message tables.
+-- The two source tables may have different column counts and columns.
+
+do $$
+declare
+  view_columns text;
+  view_sql text;
+begin
+  -- Build a stable text projection from every column present in either table.
+  -- Missing columns on the other side become NULL automatically.
+  select string_agg(
+    format('(to_jsonb(c)->>%L) as %I', x.column_name, x.column_name),
+    ', ' order by x.first_position, x.column_name
+  )
+    into view_columns
+  from (
+    select column_name, min(ordinal_position) as first_position
+    from information_schema.columns
+    where table_schema = 'public'
+      and table_name in ('chat_customer_messages', 'chat_page_messages')
+    group by column_name
+  ) x;
+
+  if view_columns is null then
+    raise exception 'No columns found in chat_customer_messages or chat_page_messages';
+  end if;
+
+  view_sql := format($sql$
+    create or replace view public.chat_messages_view as
+    select %1$s,
